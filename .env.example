# ============================================
# SAP BAS Keepalive 环境变量配置
# ============================================

# 单账号模式
BAS_URL=https://xxx.applicationstudio.cloud.sap
BAS_EMAIL=your.email@example.com
BAS_PASSWORD=yourpassword
BAS_WSID=your-workspace-id

# ============================================
# 多账号模式（推荐）- 优先级最高
# ============================================
# ⚠️ 必须写成【单行】紧凑 JSON（无换行、无缩进），多个对象之间用逗号分隔。
# ⚠️ 变量名是 ACCOUNTS，不是 ACCOUNTS_JSON。
# ⚠️ 写成美化后的多行 JSON 会解析失败：dotenv 按行读取，只会拿到第一行的 "["。
#    若要保留换行，必须写成一行并用双引号包裹、换行用 \n 转义（见下方注释示例）。
ACCOUNTS=[{"name":"账号1","url":"https://xxx.applicationstudio.cloud.sap","email":"email1@example.com","password":"password1","wsid":"workspace-id-1"},{"name":"账号2","url":"https://yyy.applicationstudio.cloud.sap","email":"email2@example.com","password":"password2","wsid":"workspace-id-2"}]

# （备选写法）保留换行的等价写法：整行双引号包裹，换行用 \n
# ACCOUNTS="[{\"name\":\"账号1\",\"url\":\"https://xxx\",\"email\":\"a@b.com\",\"password\":\"p1\",\"wsid\":\"w1\"},\n{\"name\":\"账号2\",\"url\":\"https://yyy\",\"email\":\"c@d.com\",\"password\":\"p2\",\"wsid\":\"w2\"}]"

# ============================================
# 多账号模式（备选）- 逐行索引
# ============================================
# BAS_URL_1=https://xxx.applicationstudio.cloud.sap
# BAS_EMAIL_1=email1@example.com
# BAS_PASSWORD_1=password1
# BAS_WSID_1=workspace-id-1
# BAS_NAME_1=账号1
#
# BAS_URL_2=https://yyy.applicationstudio.cloud.sap
# BAS_EMAIL_2=email2@example.com
# BAS_PASSWORD_2=password2
# BAS_WSID_2=workspace-id-2
# BAS_NAME_2=账号2

# ============================================
# 执行配置
# ============================================
# ⚠️ 重要：CRON / NO_CRON / TZ 这几个是【shell 侧】读的（entrypoint.sh），
#    写在本 .env 里【无效】——dotenv 只在 node 进程里加载，shell 看不到。
#    它们必须通过 docker run -e / docker-compose environment / HF Space secret 传入。
#
# 定时执行 Cron 表达式（不设则单次执行后退出）
# CRON="*/30 * * * *"
#
# 时区
# TZ="Asia/Shanghai"
#
# 单次执行模式（设置为1禁用定时）
# NO_CRON=1

# 浏览器模式：true=无头模式，false=显示界面
# 注意：当前 keepalive.js 里 headless 硬编码为 true，此项暂未接线（写了也不生效）
# HEADLESS=true

# "保持登录"复选框检测超时（毫秒）
# BAS_REMEMBER_WAIT_MS=1800

# 隐私弹窗点击后等待（毫秒）
# BAS_POST_PRIVACY_WAIT_MS=800
